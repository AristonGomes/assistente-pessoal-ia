  "endpoints": {
    "novos": [
      {
        "metodo": "GET",
        "rota": "/health",
        "descricao": "Health check com status IA",
        "retorna": "{ status, ia_disponivel, versao }"
      },
      {
        "metodo": "POST",
        "rota": "/chat",
        "descricao": "Chat principal com detecção de skills",
        "entrada": "{ mensagem, session_id? }",
        "saida": "{ resposta, skill_usada, tokens_entrada, tokens_saida, session_id, total_mensagens, timestamp }"
      },
      {
        "metodo": "POST",
        "rota": "/chat/limpar",
        "descricao": "Limpar histórico da sessão",
        "entrada": "{ session_id }",
        "saida": "{ status, mensagem, mensagens_limpas }"
      },
      {
        "metodo": "GET",
        "rota": "/chat/historico",
        "descricao": "Obter histórico completo",
        "parametros": "session_id",
        "saida": "{ historico: [...], total_mensagens, session_id, criada_em }"
      },
      {
        "metodo": "GET",
        "rota": "/chat/stats",
        "descricao": "Estatísticas da sessão",
        "parametros": "session_id?",
        "saida": "{ total_mensagens, tokens_entrada, tokens_saida, total_tokens, primeira_mensagem, ultima_mensagem, duracao_minutos }"
      }
    ],
    "modificados": [
      {
        "metodo": "POST",
        "rota": "/processar-texto",
        "antes": "Limpeza com NLTK",
        "depois": "Análise com IA",
        "retrocompativel": true
      },
      {
        "metodo": "POST",
        "rota": "/converter-temperatura",
        "antes": "Regex/Math",
        "depois": "Regex/Math (sem alteração)",
        "retrocompativel": true
      },
      {
        "metodo": "POST",
        "rota": "/assistente",
        "antes": "Endpoint principal",
        "depois": "Deprecated (redireciona /chat)",
        "retrocompativel": true
      }
    ]
  },

