# ============================================================================
# CONFIGURAÇÃO DO ASSISTENTE PESSOAL COM IA - TEMPLATE
# ============================================================================
#
# Este é um template de configuração. Para usar:
# 1. Copie este arquivo como .env na raiz do projeto
# 2. Preencha os valores com suas credenciais reais
# 3. NÃO compartilhe o arquivo .env (está no .gitignore)
#

# ============================================================================
# GEMINI API (OBRIGATÓRIO)
# ============================================================================

# Sua chave de API do Google Gemini
# Como obter:
#   1. Acesse https://ai.google.dev/
#   2. Clique em "Get API Key"
#   3. Crie um novo projeto ou use um existente
#   4. Copie a chave gerada
GEMINI_API_KEY=AIzaSy...

# ============================================================================
# CONFIGURAÇÕES DO ASSISTENTE
# ============================================================================

# Nome do assistente (exibido nas respostas e logs)
ASSISTANT_NAME=Orion

# Máximo de mensagens mantidas no histórico da sessão
# Padrão: 20
MAX_HISTORICO=20

# Ativar modo debug com logs detalhados (true/false)
# Padrão: false
DEBUG=false

# ============================================================================
# CONFIGURAÇÕES DO SERVIDOR (Opcional)
# ============================================================================

# Host para o servidor FastAPI
# Padrão: 127.0.0.1 (apenas localhost)
# Use 0.0.0.0 para aceitar conexões de qualquer IP
HOST=127.0.0.1

# Port para o servidor FastAPI
# Padrão: 8000
PORT=8000

# ============================================================================
# PRÓXIMAS FUNCIONALIDADES (Comentadas)
# ============================================================================

# Habilitar suporte a PDF (requer PyMuPDF)
# ENABLE_PDF_SUPPORT=false

# Habilitar entrada de voz
# ENABLE_VOICE_INPUT=false

# Habilitar integração com APIs externas
# ENABLE_EXTERNAL_API=false

